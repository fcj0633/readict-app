# 变量说明；Spring Boot 不会自动读取此文件。
# 按根目录 README 在启动终端设置环境变量，开发／测试使用不同账号。
# 本机 .local/ 下的便利工具和真实凭据不随 Git 分发。
DB_APP_USER=
DB_APP_PASSWORD=
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=

# Stable, independent secrets; never commit real values.
AUTH_RATE_HMAC_KEY=
VERIFICATION_HMAC_KEY=
VERIFICATION_SENDER=unavailable
VERIFICATION_LOCAL_ENABLED=false
