<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.readict.reading.infrastructure.persistence.mapper.ReadingProgressMapper">
  <resultMap id="entity" type="com.readict.reading.infrastructure.persistence.entity.ReadingProgressEntity">
    <result property="bookId" column="book_id" jdbcType="BINARY" typeHandler="com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler"/>
    <result property="userId" column="user_id" jdbcType="BINARY" typeHandler="com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler"/>
    <result property="artifactId" column="artifact_id" jdbcType="BINARY" typeHandler="com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler"/>
    <result property="spineHref" column="spine_href"/>
    <result property="cfi" column="cfi"/>
    <result property="blockId" column="block_id"/>
    <result property="blockOffset" column="block_offset"/>
    <result property="quoteExact" column="quote_exact"/>
    <result property="quotePrefix" column="quote_prefix"/>
    <result property="quoteSuffix" column="quote_suffix"/>
    <result property="progressRatio" column="progress_ratio"/>
    <result property="version" column="version"/>
    <result property="lastRequestId" column="last_request_id" jdbcType="BINARY" typeHandler="com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler"/>
    <result property="lastRequestHash" column="last_request_hash" jdbcType="BINARY"/>
    <result property="updatedAt" column="updated_at" typeHandler="com.readict.shared.persistence.typehandler.UtcInstantTypeHandler"/>
  </resultMap>

  <sql id="columns">book_id,user_id,artifact_id,spine_href,cfi,block_id,block_offset,quote_exact,quote_prefix,quote_suffix,progress_ratio,version,last_request_id,last_request_hash,updated_at</sql>

  <select id="find" resultMap="entity">
    SELECT <include refid="columns"/> FROM reading_progress
     WHERE book_id=#{bookId,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler}
  </select>

  <insert id="insert" parameterType="com.readict.reading.infrastructure.persistence.entity.ReadingProgressEntity">
    INSERT INTO reading_progress(book_id,user_id,artifact_id,spine_href,cfi,block_id,block_offset,
      quote_exact,quote_prefix,quote_suffix,progress_ratio,version,last_request_id,last_request_hash,updated_at)
    VALUES(#{bookId,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler},
      #{userId,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler},
      #{artifactId,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler},
      #{spineHref},#{cfi},#{blockId},#{blockOffset},#{quoteExact},#{quotePrefix},#{quoteSuffix},
      #{progressRatio},#{version},
      #{lastRequestId,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler},
      #{lastRequestHash,jdbcType=BINARY},
      #{updatedAt,jdbcType=TIMESTAMP,typeHandler=com.readict.shared.persistence.typehandler.UtcInstantTypeHandler})
  </insert>

  <update id="updateProgress">
    UPDATE reading_progress
       SET artifact_id=#{entity.artifactId,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler},
           spine_href=#{entity.spineHref},cfi=#{entity.cfi},block_id=#{entity.blockId},
           block_offset=#{entity.blockOffset},quote_exact=#{entity.quoteExact},
           quote_prefix=#{entity.quotePrefix},quote_suffix=#{entity.quoteSuffix},
           progress_ratio=#{entity.progressRatio},version=#{entity.version},
           last_request_id=#{entity.lastRequestId,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler},
           last_request_hash=#{entity.lastRequestHash,jdbcType=BINARY},
           updated_at=#{entity.updatedAt,jdbcType=TIMESTAMP,typeHandler=com.readict.shared.persistence.typehandler.UtcInstantTypeHandler}
     WHERE book_id=#{entity.bookId,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler}
       AND version=#{entity.version} - 1
  </update>

  <delete id="deleteByBook">
    DELETE FROM reading_progress
     WHERE book_id=#{bookId,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler}
  </delete>
</mapper>
