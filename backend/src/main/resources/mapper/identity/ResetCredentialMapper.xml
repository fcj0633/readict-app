<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.readict.identity.infrastructure.persistence.mapper.ResetCredentialMapper">
  <resultMap id="entity" type="com.readict.identity.infrastructure.persistence.entity.ResetCredentialEntity">
    <result property="id" column="id" jdbcType="BINARY" typeHandler="com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler"/>
    <result property="userId" column="user_id" jdbcType="BINARY" typeHandler="com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler"/>
    <result property="challengeId" column="challenge_id" jdbcType="BINARY" typeHandler="com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler"/>
    <result property="tokenHash" column="token_hash"/>
    <result property="authVersion" column="auth_version"/>
    <result property="proofMode" column="proof_mode"/>
    <result property="createdAt" column="created_at" typeHandler="com.readict.shared.persistence.typehandler.UtcInstantTypeHandler"/>
    <result property="expiresAt" column="expires_at" typeHandler="com.readict.shared.persistence.typehandler.UtcInstantTypeHandler"/>
    <result property="consumedAt" column="consumed_at" typeHandler="com.readict.shared.persistence.typehandler.UtcInstantTypeHandler"/>
  </resultMap>
  <select id="findHash" resultMap="entity">SELECT id,user_id,challenge_id,token_hash,auth_version,proof_mode,created_at,expires_at,consumed_at FROM password_reset_credential WHERE token_hash=#{hash}</select>
  <select id="lockCredential" resultMap="entity">SELECT id,user_id,challenge_id,token_hash,auth_version,proof_mode,created_at,expires_at,consumed_at FROM password_reset_credential WHERE id=#{id,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler} FOR UPDATE</select>
  <update id="revokeUser">UPDATE password_reset_credential SET consumed_at=#{now} WHERE user_id=#{id,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler} AND consumed_at IS NULL</update>
  <delete id="cleanup">DELETE FROM password_reset_credential WHERE expires_at &lt; #{before} LIMIT 200</delete>
</mapper>
