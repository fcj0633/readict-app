<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.readict.identity.infrastructure.persistence.mapper.UserMapper">
  <resultMap id="entity" type="com.readict.identity.infrastructure.persistence.entity.UserEntity">
    <result property="id" column="id" jdbcType="BINARY" typeHandler="com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler"/>
    <result property="email" column="email"/>
    <result property="emailKey" column="email_key"/>
    <result property="phoneE164" column="phone_e164"/>
    <result property="passwordHash" column="password_hash"/>
    <result property="emailVerified" column="email_verified"/>
    <result property="phoneVerified" column="phone_verified"/>
    <result property="status" column="status"/>
    <result property="authVersion" column="auth_version"/>
    <result property="createdAt" column="created_at" typeHandler="com.readict.shared.persistence.typehandler.UtcInstantTypeHandler"/>
    <result property="updatedAt" column="updated_at" typeHandler="com.readict.shared.persistence.typehandler.UtcInstantTypeHandler"/>
  </resultMap>
  <select id="findIdentifier" resultMap="entity">SELECT id,email,email_key,phone_e164,password_hash,email_verified,phone_verified,status,auth_version,created_at,updated_at FROM app_user WHERE <choose><when test="type == 'email'">email_key=#{key}</when><otherwise>phone_e164=#{key}</otherwise></choose></select>
  <select id="lockUser" resultMap="entity">SELECT id,email,email_key,phone_e164,password_hash,email_verified,phone_verified,status,auth_version,created_at,updated_at FROM app_user WHERE id=#{id,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler} FOR UPDATE</select>
  <update id="changePassword">UPDATE app_user SET password_hash=#{hash},auth_version=auth_version+1,updated_at=#{now} WHERE id=#{id,jdbcType=BINARY,typeHandler=com.readict.shared.persistence.typehandler.UuidBinaryTypeHandler} AND auth_version=#{version} AND status='ACTIVE'</update>
</mapper>
